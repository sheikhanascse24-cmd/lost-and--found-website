# Leave empty for durable local PostgreSQL-compatible storage in .data/.
# On Vercel, use a persistent PostgreSQL connection URL (for example Neon).
DATABASE_URL=
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep the same value across deployments so encrypted evidence remains readable.
APP_SECRET=
# Set to the final HTTPS website URL once deployed.
APP_URL=
# Optional email-domain restriction. This does NOT verify mailbox ownership.
COLLEGE_EMAIL_DOMAIN=
